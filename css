body {
    font-family: Arial, sans-serif;
    background-color: #f0f0f0;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
}

.container {
    text-align: center;
    background: white;
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

#color-box {
    width: 200px;
    height: 200px;
    background-color: #3498db; /* Couleur par défaut */
    margin: 20px auto;
    border-radius: 10px;
    border: 3px solid #333;
    transition: background-color 0.4s ease; /* Animation fluide */
}

#change-color-btn {
    padding: 10px 25px;
    font-size: 16px;
    cursor: pointer;
    background-color: #2c3e50;
    color: white;
    border: none;
    border-radius: 5px;
    transition: transform 0.2s;
}

#change-color-btn:active {
    transform: scale(0.95);
}
